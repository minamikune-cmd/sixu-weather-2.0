# 发布签名配置模板。
# 使用方法：复制本文件为 android/keystore.properties 并填入真实值。
# android/keystore.properties 已被 .gitignore 排除，绝不会提交到 GitHub。
#
# 生成签名密钥（仅需一次，请离线妥善备份 keystore 文件与密码）：
#   keytool -genkeypair -v -keystore sixu-weather-release.jks \
#     -alias sixu-weather -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile 路径相对于 android/ 目录，keystore 文件本身也不要提交。

storeFile=../sixu-weather-release.jks
storePassword=CHANGE_ME
keyAlias=sixu-weather
keyPassword=CHANGE_ME
